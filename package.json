{
  "name": "@tokenize-x/tx-js",
  "version": "1.0.2",
  "description": "JS/TS library to easily interact with the TX blockchain",
  "main": "dist/main/index.js",
  "module": "dist/module/index.js",
  "types": "dist/main/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/main/index.d.ts",
      "import": "./dist/module/index.js",
      "require": "./dist/main/index.js",
      "default": "./dist/main/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/tokenize-x/tx-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokenize-x/tx-js.git"
  },
  "scripts": {
    "build": "rm -rf ./dist && npm run build:main && npm run build:module",
    "prepublishOnly": "npm run build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npx ts-node tests/unit/wallet.test.ts && npx ts-node tests/unit/calculations.test.ts && npx ts-node tests/unit/endpoints.test.ts && npx ts-node tests/unit/messages/coreum.test.ts && npx ts-node tests/unit/messages/cosmos.test.ts && npx ts-node tests/unit/messages/wasm.test.ts",
    "test:integration": "npx ts-node tests/client/calculateGas.test.ts && npx ts-node tests/integration/queries.test.ts",
    "test:all": "npm test",
    "build:main": "npx tsc -p tsconfig.json",
    "build:module": "npx tsc -p tsconfig.module.json",
    "generate:docs": "npx typedoc --plugin typedoc-plugin-missing-exports --plugin typedoc-plugin-markdown src/index.ts && rm ./docs/README.md"
  },
  "keywords": [
    "coreum",
    "tx",
    "cosmos",
    "cosmjs",
    "blockchain",
    "sdk"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@cosmjs/amino": "^0.33.1",
    "@cosmjs/cosmwasm-stargate": "^0.33.1",
    "@cosmjs/crypto": "^0.33.1",
    "@cosmjs/encoding": "^0.33.1",
    "@cosmjs/math": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@cosmjs/tendermint-rpc": "^0.33.1",
    "@cosmostation/cosmos-client": "^0.0.5",
    "@cosmostation/extension-client": "^0.1.15",
    "bech32": "^2.0.0",
    "bignumber.js": "9.1.1",
    "cosmjs-types": "^0.9.0",
    "eventemitter3": "^5.0.0",
    "google-protobuf": "^3.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^18.15.9",
    "@types/ws": "^8.5.4",
    "ts-node": "^10.9.1",
    "typedoc": "^0.24.4",
    "typedoc-plugin-markdown": "^3.15.3",
    "typedoc-plugin-missing-exports": "^2.0.0",
    "typescript": "^5.0.2"
  },
  "overrides": {
    "ws": "^8.18.0"
  }
}
